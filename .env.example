# Google Sheets: File -> Share -> Publish to web -> select sheet/tab -> CSV -> Publish -> copy URL
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_PUBLISHED_ID/pub?output=csv

# How often (in seconds) to re-check the sheet for changes. Optional, defaults to 300.
REVALIDATE_SECONDS=300

# Instagram Graph API (Instagram Login) — see README "Instagram setup" for how to get these.
# Optional: without them, the header just shows a plain Instagram icon link.
INSTAGRAM_USER_ID=your-instagram-business-account-id
INSTAGRAM_ACCESS_TOKEN=your-long-lived-instagram-access-token
